# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenRouteService key (free at https://openrouteservice.org/dev/#/signup).
# Optional: without it the app uses the public OSRM demo server for routing
# and Nominatim for geocoding.
ORS_API_KEY=

# Nominatim usage policy requires an identifying User-Agent with contact info.
# Nominatim rejects placeholder contacts such as example.com addresses.
NOMINATIM_USER_AGENT=routewise/1.0 (+https://github.com/<your-user>/<your-repo>)
# Optional comma-separated ISO country codes to restrict geocoding, e.g. "us,ca"
GEOCODE_COUNTRY_CODES=

# Optional: use Redis instead of the in-process LocMem cache.
REDIS_URL=

# Optional provider endpoint overrides
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
